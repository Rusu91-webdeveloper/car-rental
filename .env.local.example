# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# PostgreSQL (use a disposable/non-production database locally)
DATABASE_URL=postgresql://user:password@localhost:5432/rentcar

# Auth.js / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
ADMIN_EMAILS=
ADMIN_EMAIL=
# Separate comma-separated allowlist for destructive developer maintenance.
# Do not add the rental-company owner unless they maintain the application.
MAINTENANCE_DEVELOPER_EMAILS=
SUPPORT_EMAIL=

# Public legal/contact identity (database settings take precedence)
PUBLIC_COMPANY_EMAIL=
PUBLIC_COMPANY_PHONE=
PUBLIC_COMPANY_ADDRESS=
PUBLIC_COMPANY_CITY=
PUBLIC_COMPANY_STATE=
PUBLIC_COMPANY_ZIP_CODE=
PUBLIC_COMPANY_COUNTRY=Deutschland
PUBLIC_MANAGING_DIRECTOR=
PUBLIC_COMMERCIAL_REGISTER=
PUBLIC_REGISTER_COURT=
PUBLIC_VAT_ID=
PUBLIC_RESPONSIBLE_PERSON=

# Shared PostgreSQL rate limiting (use a distinct random production secret)
RATE_LIMIT_HASH_SECRET=

# Email: Gmail SMTP. Use a dedicated Google account with 2-Step Verification
# and a 16-character App Password; never use the normal account password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM=

# Private documents. Keep disabled until production provisioning is approved.
PRIVATE_DOCUMENTS_ENABLED=false
PRIVATE_DOCUMENT_STORAGE_PROVIDER=local-private
PRIVATE_DOCUMENT_REVIEW_MODE=manual
PRIVATE_DOCUMENT_SCANNER_ENABLED=false
PRIVATE_DOCUMENT_ENVIRONMENT=local
PRIVATE_DOCUMENT_LOCAL_ROOT=/tmp/car-rental-private-documents
PRIVATE_DOCUMENT_MAXIMUM_UPLOAD_BYTES=10485760
PRIVATE_DOCUMENT_UPLOAD_GRANT_SECONDS=600
PRIVATE_DOCUMENT_RECENT_AUTH_SECONDS=600
PRIVATE_DOCUMENT_RECONCILIATION_BATCH_SIZE=50
PRIVATE_DOCUMENT_BLOB_STORE_ID=
PRIVATE_DOCUMENT_BLOB_REGION=fra1
PRIVATE_DOCUMENT_BLOB_PRIVATE_ACCESS_ATTESTED=false
PRIVATE_DOCUMENT_BLOB_REGION_ATTESTED=false

# Injected by the approved Vercel project/integration; do not paste static
# production Blob credentials into environment files.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Workers are scheduled by vercel.json. Enable them only after the launch
# owner approves alerting, retention, and the deletion runbook.
PHASE8FB_WORKERS_ENABLED=false
# Comma-separated staged allowlist in the documented rollout order.
PHASE8FB_WORKER_JOBS_ENABLED=
PHASE8FB_WORKER_SECRET=
BOOKING_MAINTENANCE_WORKER_ENABLED=false
CRON_SECRET=

# Operational attestations consumed by the protected health dashboard.
PRODUCTION_ALERTING_ATTESTED=false
PRODUCTION_OWNER=
PRODUCTION_ALERT_OWNER=
PRODUCTION_ALERT_RECIPIENT=
DATABASE_RECOVERY_OWNER=
WORKER_MAINTENANCE_OWNER=
DATABASE_BACKUP_VERIFIED_AT=
DATABASE_RESTORE_VERIFIED_AT=

# Existing manual bank-transfer presentation
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_SWIFT_CODE=

# Existing administrator-managed vehicle media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rentcar/cars

# Online payment remains intentionally disabled and is not a Phase 9 launch
# dependency. Do not configure Stripe for this release.
