/// Shared fixed-window counters used by production rate limiting. Subjects are
/// stored only as keyed hashes so user identifiers never become operational
/// metadata.
model RateLimitBucket {
  id              String   @id @default(cuid())
  scope           String   @db.VarChar(64)
  subjectHash     String   @db.Char(64)
  windowStartedAt DateTime
  resetAt         DateTime
  count           Int      @default(1)
  updatedAt       DateTime @updatedAt

  @@unique([scope, subjectHash, windowStartedAt])
  @@index([resetAt])
}

/// Bounded, production-safe worker execution evidence. Payloads, document
/// identifiers, Blob paths, and customer data are intentionally excluded.
model WorkerExecution {
  id               String    @id @default(cuid())
  job              String    @db.VarChar(64)
  invocationId     String    @unique @db.VarChar(64)
  deduplicationKey String?   @unique @db.VarChar(128)
  status           String    @db.VarChar(16)
  triggerSource    String    @default("legacy") @db.VarChar(32)
  environment      String?   @db.VarChar(32)
  deploymentRef    String?   @db.VarChar(128)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  examined         Int?
  succeeded        Int?
  failed           Int?
  failureCode      String?   @db.VarChar(64)
  failureSummary   String?   @db.VarChar(256)

  @@index([job, startedAt])
  @@index([status, startedAt])
  @@index([triggerSource, startedAt])
}

/// A short durable lease prevents the same worker job from running
/// concurrently across serverless instances. Expired leases can be reclaimed.
model WorkerLease {
  job            String   @id @db.VarChar(64)
  invocationId   String   @unique @db.VarChar(64)
  acquiredAt     DateTime
  leaseExpiresAt DateTime
  updatedAt      DateTime @updatedAt

  @@index([leaseExpiresAt])
}

enum OperationalEvidenceType {
  ALERT_DELIVERY
  BACKUP_VERIFICATION
  RESTORE_VERIFICATION
}

enum OperationalEvidenceStatus {
  REQUESTED
  SUCCEEDED
  FAILED
}

/// Durable, customer-data-free operational evidence. Operator identifiers are
/// authenticated application user IDs; raw database URLs and recipients are
/// never stored.
model OperationalEvidence {
  id                  String                    @id @default(cuid())
  type                OperationalEvidenceType
  status              OperationalEvidenceStatus
  environment         String                    @db.VarChar(32)
  operatorId          String                    @db.VarChar(64)
  verifiedById        String?                   @db.VarChar(64)
  deduplicationKey    String                    @unique @db.VarChar(128)
  requestedAt         DateTime                  @default(now())
  verifiedAt          DateTime?
  completedAt         DateTime?
  databaseFingerprint String?                   @db.VarChar(128)
  notes               String?                   @db.VarChar(500)
  failureCode         String?                   @db.VarChar(64)
  failureSummary      String?                   @db.VarChar(256)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([type, environment, requestedAt])
  @@index([type, status, verifiedAt])
  @@index([operatorId, requestedAt])
  @@index([verifiedById, verifiedAt])
}
