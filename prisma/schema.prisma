generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - synced with NextAuth
model User {
  id            String    @id @default(cuid())
  providerId    String?
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  bookings         Booking[]
  reviews          Review[]
  savedCars        SavedCar[]
  adminActions     AdminAuditLog[]
  stripeCustomerId String?

  configurationVersionsCreated   ConfigurationVersion[]              @relation("ConfigurationVersionCreatedBy")
  configurationVersionsUpdated   ConfigurationVersion[]              @relation("ConfigurationVersionUpdatedBy")
  configurationVersionsValidated ConfigurationVersion[]              @relation("ConfigurationVersionValidatedBy")
  configurationReleasesCreated   BusinessConfigurationRelease[]      @relation("ConfigurationReleaseCreatedBy")
  configurationReleasesUpdated   BusinessConfigurationRelease[]      @relation("ConfigurationReleaseUpdatedBy")
  configurationReleasesValidated BusinessConfigurationRelease[]      @relation("ConfigurationReleaseValidatedBy")
  configurationReleasesActivated BusinessConfigurationRelease[]      @relation("ConfigurationReleaseActivatedBy")
  fleetRateSetsCreated           FleetRateSet[]                      @relation("FleetRateSetCreatedBy")
  fleetRateSetsUpdated           FleetRateSet[]                      @relation("FleetRateSetUpdatedBy")
  fleetRateSetsValidated         FleetRateSet[]                      @relation("FleetRateSetValidatedBy")
  fleetRateSetsActivated         FleetRateSet[]                      @relation("FleetRateSetActivatedBy")
  legalDocumentsCreated          LegalDocumentVersion[]              @relation("LegalDocumentCreatedBy")
  legalDocumentsUpdated          LegalDocumentVersion[]              @relation("LegalDocumentUpdatedBy")
  legalDocumentsPublished        LegalDocumentVersion[]              @relation("LegalDocumentPublishedBy")
  legalDocumentsValidated        LegalDocumentVersion[]              @relation("LegalDocumentValidatedBy")
  legalAcceptances               BookingLegalAcceptance[]            @relation("LegalAcceptanceCustomer")
  ownedCustomerDocuments         CustomerDocument[]                  @relation("CustomerDocumentOwner")
  uploadedCustomerDocuments      CustomerDocument[]                  @relation("CustomerDocumentUploader")
  documentUploadSessions         DocumentUploadSession[]             @relation("DocumentUploadSessionCustomer")
  documentLegalHoldsApplied      DocumentLegalHold[]                 @relation("DocumentLegalHoldAppliedBy")
  documentLegalHoldsReleased     DocumentLegalHold[]                 @relation("DocumentLegalHoldReleasedBy")
  documentDeletionsRequested     DocumentDeletionRequest[]           @relation("DocumentDeletionRequestedBy")
  customerDocumentsReviewed      CustomerDocument[]                  @relation("CustomerDocumentReviewedBy")
  documentReviewDecisions        CustomerDocumentReviewDecision[]    @relation("CustomerDocumentDecisionReviewedBy")
  documentReviewEvidence         CustomerDocumentReviewDecision[]    @relation("CustomerDocumentDecisionCustomer")
  bookingApplications            BookingApplication[]                @relation("BookingApplicationCustomer")
  applicationQuotesConfirmed     BookingApplicationPricingQuote[]    @relation("BookingApplicationQuoteConfirmedBy")
  applicationLegalAcceptances    BookingApplicationLegalAcceptance[] @relation("BookingApplicationLegalAcceptanceCustomer")
  accessRoleAssignments          UserAccessRole[]
  auditEvents                    AuditEvent[]                        @relation("AuditEventActor")
  paymentsRecorded               Payment[]                           @relation("PaymentRecordedBy")

  @@index([providerId])
  @@index([email])
  @@index([isActive])
}

// NextAuth Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

// Car model with proper constraints
model Car {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  nameDe        String?
  subtitle      String?
  subtitleDe    String?
  description   String      @db.Text
  descriptionDe String?     @db.Text
  category      CarCategory
  price         Int // price per day in cents
  image         String
  images        String[]    @default([])
  status        CarStatus   @default(AVAILABLE)

  // Specs
  gearbox      String
  seats        Int
  fuelType     String
  acceleration String
  year         Int?

  // Ratings
  rating      Float @default(0)
  reviewCount Int   @default(0)

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings                       Booking[]
  reviews                        Review[]
  savedBy                        SavedCar[]
  blockedDates                   BlockedDate[]
  rentalRates                    VehicleRentalRate[]
  insuranceAvailability          InsuranceVehicleAvailability[]
  insuranceAvailabilitySnapshots BookingInsuranceSnapshot[]             @relation("InsuranceAvailabilityVehicle")
  applicationInsuranceSelections BookingApplicationInsuranceSelection[] @relation("ApplicationInsuranceAvailabilityVehicle")
  documentUploadSessions         DocumentUploadSession[]
  bookingApplications            BookingApplication[]

  @@index([category])
  @@index([status])
  @@index([isDeleted])
  @@index([year])
}

enum CarCategory {
  ELECTRIC
  LUXURY
  SUV
  SEDAN
  EV
}

enum CarStatus {
  AVAILABLE
  LOW_STOCK
  RENTED
  MAINTENANCE
}

// Booking with proper constraints to prevent double-booking
model Booking {
  id            String @id @default(cuid())
  bookingNumber String @unique @default(cuid())
  transferCode  String @unique
  locale        String @default("de")

  userId String
  user   User   @relation(fields: [userId], references: [id])

  carId String
  car   Car    @relation(fields: [carId], references: [id])

  // Dates stored in UTC
  pickupDate  DateTime
  dropoffDate DateTime
  location    String

  // Pricing
  pricePerDay          Int // in cents, locked at booking time
  totalDays            Int
  totalPrice           Int // in cents
  depositAmount        Int // in cents
  advancePaymentAmount Int @default(0) // exact amount required before confirmation
  guaranteeAmount      Int @default(0) // in cents, refundable security hold

  // Status
  status             BookingStatus        @default(PENDING)
  paymentStatus      PaymentStatus        @default(PENDING)
  paymentMethod      BookingPaymentMethod @default(TRANSFER)
  refundReviewStatus RefundReviewStatus   @default(NOT_REQUIRED)

  // Stripe
  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique

  // Timestamps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  completedAt  DateTime?
  paymentDueAt DateTime?

  // Relations
  payments               Payment[]
  review                 Review?
  adminActions           AdminAuditLog[]
  pricingSnapshot        BookingPricingSnapshot?
  customerDriverSnapshot BookingCustomerDriverSnapshot?
  insuranceSnapshot      BookingInsuranceSnapshot?
  legalAcceptances       BookingLegalAcceptance[]
  customerDocuments      CustomerDocument[]
  documentUploadSession  DocumentUploadSession?
  sourceApplication      BookingApplication?
  notifications          BookingNotification[]
  paymentPolicySnapshot  BookingPaymentPolicySnapshot?

  @@unique([carId, pickupDate, dropoffDate]) // Prevent exact duplicate bookings
  @@index([userId])
  @@index([carId])
  @@index([status])
  @@index([paymentMethod])
  @@index([status, paymentStatus, paymentDueAt])
  @@index([refundReviewStatus])
  @@index([pickupDate, dropoffDate])
  @@index([transferCode])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  DEPOSIT_PAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BookingPaymentMethod {
  TRANSFER
  PAY_AT_PICKUP
}

enum PaymentPurpose {
  DEPOSIT
  BALANCE
  FULL
}

enum PaymentKind {
  RECEIPT
  REFUND
}

enum RefundReviewStatus {
  NOT_REQUIRED
  PENDING
  RESOLVED
}

enum BookingNotificationEvent {
  CUSTOMER_TRANSFER_INSTRUCTIONS
  CUSTOMER_CASH_CONFIRMATION
  CUSTOMER_TRANSFER_CONFIRMED
  CUSTOMER_TRANSFER_EXPIRED
  CUSTOMER_ADVANCE_INSTRUCTIONS
  CUSTOMER_BOOKING_CONFIRMED
  CUSTOMER_BALANCE_RECEIPT
  CUSTOMER_BOOKING_CANCELLED
  CUSTOMER_REFUND_CONFIRMED
  CUSTOMER_PAYMENT_EXPIRED
  ADMIN_BOOKING_CREATED
}

enum BookingNotificationRecipient {
  CUSTOMER
  ADMIN
}

enum BookingNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum BookingApplicationStatus {
  DRAFT
  AWAITING_DOCUMENT_UPLOAD
  AWAITING_DOCUMENT_REVIEW
  CUSTOMER_ACTION_REQUIRED
  READY_TO_FINALIZE
  FINALIZING
  FINALIZED
  EXPIRED
  CANCELLED
  REJECTED
}

enum BookingApplicationActionReason {
  PRICE_CHANGED
  VEHICLE_UNAVAILABLE
  CONFIGURATION_CHANGED
  LEGAL_VERSION_CHANGED
  RENTAL_DATES_CHANGED
  INSURANCE_CHANGED
  PAYMENT_RULES_CHANGED
  CUSTOMER_DATA_INVALID
  DOCUMENT_REPLACEMENT_REQUIRED
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([carId])
}

// Payment tracking
model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  amount       Int // in cents
  currency     String                @default("usd")
  status       PaymentStatus
  kind         PaymentKind           @default(RECEIPT)
  purpose      PaymentPurpose?
  method       BookingPaymentMethod?
  receivedAt   DateTime?
  recordedById String?
  recordedBy   User?                 @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  stripePaymentIntentId String?
  stripeChargeId        String?

  metadata Json?
  reason   String? @db.Text

  relatedPaymentId String?
  relatedPayment   Payment?  @relation("PaymentRefunds", fields: [relatedPaymentId], references: [id], onDelete: SetNull)
  refunds          Payment[] @relation("PaymentRefunds")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([stripePaymentIntentId])
  @@index([recordedById, receivedAt])
  @@index([bookingId, kind, status])
  @@index([relatedPaymentId])
}

model BookingNotification {
  id                String                       @id @default(cuid())
  bookingId         String
  booking           Booking                      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event             BookingNotificationEvent
  recipient         BookingNotificationRecipient
  eventKey          String                       @unique @db.VarChar(160)
  status            BookingNotificationStatus    @default(PENDING)
  attemptCount      Int                          @default(0)
  nextAttemptAt     DateTime                     @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  providerMessageId String?                      @db.VarChar(255)
  lastErrorCode     String?                      @db.VarChar(64)
  payloadSnapshot   Json?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([bookingId, createdAt])
}

model BookingPaymentPolicySnapshot {
  id                     String                @id @default(cuid())
  bookingId              String                @unique
  booking                Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentConfigVersionId String?
  configuredPaymentMode  ConfiguredPaymentMode
  bookingPaymentMethod   BookingPaymentMethod
  depositType            DepositType
  depositValue           Int
  depositRateBps         Int?
  depositAmount          Int
  advancePaymentAmount   Int
  remainingBalanceRule   RemainingBalanceRule
  instructionLocale      String                @db.VarChar(10)
  instructionText        String?               @db.Text
  accountName            String?
  iban                   String?
  bic                    String?
  bankName               String?
  companyName            String?
  companyEmail           String?
  companyPhone           String?
  companyAddress         String?
  companyPostalCode      String?
  companyCity            String?
  companyCountry         String?
  capturedAt             DateTime              @default(now())

  @@index([paymentConfigVersionId])
  @@index([configuredPaymentMode])
}

// Blocked dates for maintenance or other reasons
model BlockedDate {
  id    String @id @default(cuid())
  carId String
  car   Car    @relation(fields: [carId], references: [id])

  startDate DateTime
  endDate   DateTime
  reason    String?

  createdAt DateTime @default(now())

  @@index([carId])
  @@index([startDate, endDate])
}

// Saved cars (favorites)
model SavedCar {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  carId  String
  car    Car    @relation(fields: [carId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, carId])
  @@index([userId])
}

// Admin audit log for accountability
model AdminAuditLog {
  id      String @id @default(cuid())
  adminId String
  admin   User   @relation(fields: [adminId], references: [id])

  action     AdminAction
  targetType String // "booking", "car", "user"
  targetId   String

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  oldValue Json?
  newValue Json?
  reason   String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum AdminAction {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_STATUS_CHANGED
  BOOKING_CANCELLED
  BOOKING_REJECTED
  PAYMENT_RECEIVED
  PAYMENT_REFUNDED
  REFUND_REVIEW_RESOLVED
  NOTIFICATION_RETRIED
  CAR_CREATED
  CAR_UPDATED
  CAR_DELETED
  USER_ROLE_CHANGED
  BLOCKED_DATE_ADDED
  BLOCKED_DATE_REMOVED
  SETTINGS_UPDATED
  MAINTENANCE_CLEANUP
}

// Company settings - single record to store all company configuration
model CompanySettings {
  id String @id @default("company-settings")

  // Company Information
  companyName    String  @default("Qujo Autovermietung GmbH")
  companyEmail   String  @default("")
  companyPhone   String?
  companyAddress String?
  companyCity    String?
  companyState   String?
  companyZipCode String?
  companyCountry String? @default("Deutschland")

  // Legal Information (for Impressum/Imprint)
  managingDirector   String?
  commercialRegister String?
  registerCourt      String?
  vatId              String?
  responsiblePerson  String?

  // Bank/Payment Details
  bankName      String  @default("")
  accountName   String  @default("")
  accountNumber String  @default("")
  swiftCode     String  @default("")
  iban          String?

  // Tax Configuration
  taxRate             Float   @default(0.0) // Tax rate as decimal (e.g., 0.19 for 19%)
  taxIncluded         Boolean @default(false) // Whether tax is included in displayed prices
  depositPercentage   Float   @default(0.2) // Deposit percentage as decimal (e.g., 0.2 for 20%)
  guaranteePercentage Float   @default(0.0) // Refundable security hold percentage (e.g., 0.3 for 30%)

  // Email Configuration
  supportEmail String @default("")
  adminEmail   String @default("")

  // Additional Settings
  currency       String @default("EUR")
  currencySymbol String @default("€")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

