generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - synced with NextAuth
model User {
  id          String   @id @default(cuid())
  providerId  String?  @unique
  email       String   @unique
  emailVerified DateTime?
  name        String?
  image       String?
  role        Role     @default(USER)
  isActive    Boolean  @default(true)
  deactivatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  reviews       Review[]
  savedCars     SavedCar[]
  adminActions  AdminAuditLog[]
  stripeCustomerId String?

  @@index([providerId])
  @@index([email])
  @@index([isActive])
}

// NextAuth Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

// Car model with proper constraints
model Car {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  nameDe      String?
  subtitle    String?
  subtitleDe  String?
  description String      @db.Text
  descriptionDe String?   @db.Text
  category    CarCategory
  price       Int // price per day in cents
  image       String
  images      String[]  @default([])
  status      CarStatus   @default(AVAILABLE)
  
  // Specs
  gearbox      String
  seats        Int
  fuelType     String
  acceleration String
  year         Int?
  
  // Ratings
  rating       Float       @default(0)
  reviewCount  Int         @default(0)
  
  // Soft delete
  isDeleted    Boolean     @default(false)
  deletedAt    DateTime?
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  bookings     Booking[]
  reviews      Review[]
  savedBy      SavedCar[]
  blockedDates BlockedDate[]

  @@index([category])
  @@index([status])
  @@index([isDeleted])
  @@index([year])
}

enum CarCategory {
  ELECTRIC
  LUXURY
  SUV
  SEDAN
  EV
}

enum CarStatus {
  AVAILABLE
  LOW_STOCK
  RENTED
  MAINTENANCE
}

// Booking with proper constraints to prevent double-booking
model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique @default(cuid())
  transferCode    String        @unique
  
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  carId           String
  car             Car           @relation(fields: [carId], references: [id])
  
  // Dates stored in UTC
  pickupDate      DateTime
  dropoffDate     DateTime
  location        String
  
  // Pricing
  pricePerDay     Int // in cents, locked at booking time
  totalDays       Int
  totalPrice      Int // in cents
  depositAmount   Int // in cents
  guaranteeAmount Int @default(0) // in cents, refundable security hold
  
  // Status
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   BookingPaymentMethod @default(TRANSFER)
  
  // Stripe
  stripeSessionId    String?   @unique
  stripePaymentIntentId String? @unique
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?
  
  // Relations
  payments        Payment[]
  review          Review?
  adminActions    AdminAuditLog[]

  @@unique([carId, pickupDate, dropoffDate]) // Prevent exact duplicate bookings
  @@index([userId])
  @@index([carId])
  @@index([status])
  @@index([paymentMethod])
  @@index([pickupDate, dropoffDate])
  @@index([transferCode])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BookingPaymentMethod {
  TRANSFER
  PAY_AT_PICKUP
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([carId])
}

// Payment tracking
model Payment {
  id                   String   @id @default(cuid())
  bookingId            String
  booking              Booking  @relation(fields: [bookingId], references: [id])
  
  amount               Int // in cents
  currency             String   @default("usd")
  status               PaymentStatus
  
  stripePaymentIntentId String?
  stripeChargeId        String?
  
  metadata             Json?
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([bookingId])
  @@index([stripePaymentIntentId])
}

// Blocked dates for maintenance or other reasons
model BlockedDate {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  
  startDate DateTime
  endDate   DateTime
  reason    String?
  
  createdAt DateTime @default(now())

  @@index([carId])
  @@index([startDate, endDate])
}

// Saved cars (favorites)
model SavedCar {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  
  createdAt DateTime @default(now())

  @@unique([userId, carId])
  @@index([userId])
}

// Admin audit log for accountability
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id])
  
  action      AdminAction
  targetType  String // "booking", "car", "user"
  targetId    String
  
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  
  oldValue    Json?
  newValue    Json?
  reason      String?
  
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum AdminAction {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REJECTED
  CAR_CREATED
  CAR_UPDATED
  CAR_DELETED
  USER_ROLE_CHANGED
  BLOCKED_DATE_ADDED
  BLOCKED_DATE_REMOVED
  SETTINGS_UPDATED
}

// Company settings - single record to store all company configuration
model CompanySettings {
  id        String   @id @default("company-settings")
  
  // Company Information
  companyName       String   @default("RentCar GmbH")
  companyEmail      String   @default("info@rentcar.de")
  companyPhone      String?  @default("+49 (0) 30 12345678")
  companyAddress    String?  @default("Musterstraße 123")
  companyCity       String?  @default("10115 Berlin")
  companyState      String?
  companyZipCode    String?
  companyCountry    String?  @default("Deutschland")
  
  // Legal Information (for Impressum/Imprint)
  managingDirector  String?  @default("Max Mustermann")
  commercialRegister String? @default("HRB 123456 B")
  registerCourt     String?  @default("Amtsgericht Berlin-Charlottenburg")
  vatId             String?  @default("DE123456789")
  responsiblePerson String?  @default("Max Mustermann, Musterstraße 123, 10115 Berlin, Deutschland")
  
  // Bank/Payment Details
  bankName          String   @default("Your Bank Name")
  accountName       String   @default("Car Rental Company")
  accountNumber     String   @default("1234567890")
  swiftCode         String   @default("YOURSWIFT")
  iban              String?
  
  // Tax Configuration
  taxRate           Float    @default(0.0) // Tax rate as decimal (e.g., 0.19 for 19%)
  taxIncluded       Boolean  @default(false) // Whether tax is included in displayed prices
  depositPercentage Float    @default(0.2) // Deposit percentage as decimal (e.g., 0.2 for 20%)
  guaranteePercentage Float  @default(0.0) // Refundable security hold percentage (e.g., 0.3 for 30%)
  
  // Email Configuration
  supportEmail      String   @default("support@rentcar.com")
  adminEmail        String   @default("admin@rentcar.com")
  
  // Additional Settings
  currency          String   @default("EUR")
  currencySymbol    String   @default("€")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
